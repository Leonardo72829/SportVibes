# SportVibes — Virtual host de ejemplo para Nginx en el VPS.
# Copiar a /etc/nginx/sites-available/sportvibes y crear el enlace simbólico
# en /etc/nginx/sites-enabled/. Ajustar dominio y versión de PHP-FPM.

server {
    listen 80;
    server_name tudominio.com www.tudominio.com;

    root /var/www/sportvibes/public;
    index index.php;

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # Evita servir archivos ocultos (.env, .git, etc.)
    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~* \.(jpg|jpeg|png|gif|webp|css|js|ico)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # Activar HTTPS con: sudo certbot --nginx -d tudominio.com -d www.tudominio.com
}
