# Secretos y entorno local (NUNCA subir a GitHub)
.env
*.env.local

# Subidas de usuarios (solo se versiona el marcador de carpeta)
public/uploads/*
!public/uploads/.gitkeep

# Documento de avance pesado (68 MB): se mantiene local, no se sube a GitHub
docs/SportVibes AVANCE.pdf

# Base de datos local y exportaciones (pueden contener datos de clientes)
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-wal
database/*.sqlite-shm
database/migracion_datos.sql

# Correos capturados en desarrollo (pueden contener datos de clientes)
storage/correos/*
!storage/correos/.gitkeep

# Logs y temporales
*.log
*.tmp
*.bak

# Dependencias y herramientas
vendor/
node_modules/
.vscode/
.idea/
.DS_Store
Thumbs.db
