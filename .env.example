# Copiar este archivo como .env en la raíz del proyecto y ajustar los valores.
# El archivo .env está excluido de GitHub (.gitignore). Nunca subas secretos.

APP_NAME=SportVibes
# local en desarrollo; production en el VPS
APP_ENV=local
# Sin barra final. En producción: https://tudominio.com
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Mexico_City
APP_DEBUG=true

# --- Base de datos ---
# Desarrollo: sqlite + DB_PATH. Producción: mysql + DB_HOST/DB_NAME/DB_USER/DB_PASS
DB_DRIVER=sqlite
DB_PATH=database/sportvibes.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sportvibes
DB_USER=sportvibes_user
DB_PASS=cambia_esta_contraseña

# --- Correo SMTP (PHPMailer) ---
# Si SMTP_HOST está vacío, los avisos se guardan en la tabla notificaciones
# pero no se envían por correo.
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
# tls | ssl | none
SMTP_SEGURIDAD=tls
SMTP_USUARIO=correo@tudominio.com
SMTP_CLAVE=cambia_esta_contraseña
SMTP_FROM=no-reply@tudominio.com
SMTP_FROM_NOMBRE=SportVibes

# --- Negocio ---
# Envío dentro de México (SP10: monto fijo)
COSTO_ENVIO=99
