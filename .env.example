# Copiar este archivo como .env en la raíz del proyecto y ajustar los valores.
# El archivo .env está excluido de GitHub (.gitignore).

APP_NAME=SportVibes
APP_ENV=production
APP_URL=https://tudominio.com
APP_TIMEZONE=America/Mexico_City
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sportvibes
DB_USER=sportvibes_user
DB_PASS=cambia_esta_contraseña
